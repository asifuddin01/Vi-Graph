# Copy to .env and adjust. All backend settings use the VIGRAPH_ prefix
# (see backend/app/config.py).

# --- Backend ---
VIGRAPH_ENV=development
VIGRAPH_LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins for the frontend.
VIGRAPH_CORS_ORIGINS=http://localhost:3000

# Where uploads, results, and the SQLite DB live. Must be outside any
# executable/static path (§29).
VIGRAPH_STORAGE_DIR=./storage

# Upload and inference limits (§29). The rate limit is per client IP; 0 disables it.
VIGRAPH_MAX_UPLOAD_MB=10
VIGRAPH_ANALYZE_RATE_LIMIT_PER_MINUTE=10
VIGRAPH_QA_RATE_LIMIT_PER_MINUTE=30

# Stage A image preprocessing (§8): downscale only when the longest side exceeds
# this; reject images with more pixels than the limit (checked before decoding).
VIGRAPH_IMAGE_MAX_SIDE=2048
VIGRAPH_IMAGE_MAX_PIXELS=40000000

# --- VLM backend (§33.3: single swap point) ---
# "mock" runs without a GPU and returns canned graphs; "hf" loads a local
# Hugging Face model.
VIGRAPH_VLM_BACKEND=mock
# "hf" needs `pip install -r requirements-vlm.txt` and access to huggingface.co.
# Tentative default model (see CLAUDE.md). Any AutoModelForImageTextToText model works.
VIGRAPH_VLM_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
# Optional Hub revision (branch/tag/commit) to pin.
VIGRAPH_VLM_REVISION=
# Optional path to a LoRA adapter produced by a Colab training run (§18).
VIGRAPH_VLM_ADAPTER_PATH=
# auto | float16 | bfloat16 | float32. Use float16 on a T4 (no native bfloat16).
VIGRAPH_VLM_DTYPE=auto
VIGRAPH_VLM_DEVICE_MAP=auto

# --- Frontend ---
# Next.js only loads .env files from frontend/, not the repo root. For local
# dev put this in frontend/.env.local (defaults to http://localhost:8000 if
# unset). It is inlined at build time; docker-compose passes it as a build arg.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
